# Copy to multi-router.env and replace each value with a different random token.
# Keep this file out of Git and do not reuse the old single-router tokens casually.
HOME_APP_TOKEN=replace-me
HOME_HOOK_TOKEN=replace-me
BE50_APP_TOKEN=eb1b0f5520c9edef1c4f12ba3a3578a995b27c27c5342f2afd954430b558916e
BE50_HOOK_TOKEN=a50ef2019882d8288009a697d6364c96f6024bf2ac5989b05036d618998b02bd

# Credentials of the existing local MQTT broker.
MQTT_USERNAME=labprobe
MQTT_PASSWORD=replace-me

# Optional: use the same public MQTT URL as the existing Hub if its MQTT transport is enabled.
MQTT_PUBLIC_URL=
