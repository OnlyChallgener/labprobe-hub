#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled
    enabled="$(uci -q get mihomo_web.main.enabled 2>/dev/null)"
    [ "$enabled" != 0 ] || return 0
    . /usr/libexec/mihomo-web/functions.sh
    mihomo_prepare || return 1
    # Validate before asking procd to create a respawning process.
    /usr/bin/mihomo -t -d "$MIHOMO_HOME" -f "$MIHOMO_HOME/config.yaml" || return 1
    procd_open_instance
    procd_set_param command /usr/bin/mihomo -d "$MIHOMO_HOME" -f "$MIHOMO_HOME/config.yaml" \
        -ext-ctl "$MIHOMO_LAN_ADDRESS:$MIHOMO_CONTROLLER_PORT" \
        -ext-ui /usr/share/mihomo-web/ui
    procd_set_param env CLASH_OVERRIDE_SECRET="$MIHOMO_API_SECRET"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$MIHOMO_HOME/config.yaml" "$MIHOMO_HOME/api.secret"
    procd_set_param limits core="0 0" nofile="65535 65535"
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger mihomo_web network
    procd_add_interface_trigger 'interface.*' lan /etc/init.d/mihomo-web restart
}
