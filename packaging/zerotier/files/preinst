#!/bin/sh
set -eu
[ -z "${IPKG_INSTROOT:-}" ] || exit 0
[ -c /dev/net/tun ] || { echo 'TUN device /dev/net/tun is required.' >&2; exit 1; }
# Refuse existing unmanaged binaries or homes: silently creating a new identity would be unsafe.
if ! opkg status zerotier-one-static 2>/dev/null | grep -q '^Status: .* installed$'; then
    if pidof zerotier-one >/dev/null 2>&1; then
        echo 'An unmanaged ZeroTier process is running. Stop it before installation.' >&2
        exit 1
    fi
    for command in /usr/bin/zerotier-one /usr/sbin/zerotier-one; do
        [ ! -e "$command" ] || { echo "Existing ZeroTier binary: $command; migrate it first." >&2; exit 1; }
    done
    for home in /var/lib/zerotier-one /etc/zerotier /etc/zerotier-one; do
        [ ! -e "$home/identity.secret" ] || { echo "Existing ZeroTier identity: $home; migrate it first." >&2; exit 1; }
    done
fi
exit 0
