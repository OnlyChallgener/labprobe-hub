#!/bin/sh /etc/rc.common
START=90
STOP=10
USE_PROCD=1

start_service() {
    local enabled port
    config_load zerotier_static
    config_get_bool enabled main enabled 1
    [ "$enabled" = 1 ] || return 0
    config_get port main port 9993
    case "$port" in ''|*[!0-9]*) logger -t zerotier-static 'Invalid UDP port'; return 1;; esac
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
    [ -c /dev/net/tun ] || { logger -t zerotier-static '/dev/net/tun is missing'; return 1; }
    mkdir -p /etc/zerotier-one
    chmod 700 /etc/zerotier-one
    procd_open_instance
    procd_set_param command /usr/bin/zerotier-one "-p$port" /etc/zerotier-one
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger zerotier_static
}
